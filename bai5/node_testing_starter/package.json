{
  "name": "node-testing-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.3",
    "jest": "30.5.2",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3"
  }
}
