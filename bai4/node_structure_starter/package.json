{
  "name": "node-structure-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "legacy": "tsx src/legacyServer.ts",
    "smoke": "tsx src/smoke.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
